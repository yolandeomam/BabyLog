@page "/about"
@rendermode InteractiveServer
@inject BabyLog.Client.Services.TokenStorageService TokenStorage
@inject NavigationManager Navigation

<PageTitle>Om BabyFællesskab</PageTitle>

<div class="about-container">

    <!-- About header -->
    <div class="about-hero">

        <span class="about-label">
            BabyFællesskab
        </span>

        <h1>
            Om BabyFællesskab
        </h1>

        <p>
            BabyFællesskab er skabt med ønsket om at give forældre et trygt,
            overskueligt og støttende sted, hvor fællesskab og digitale værktøjer
            kan gøre hverdagen med små børn lettere.
        </p>

    </div>

    <!-- About cards -->
    <div class="about-grid">

        <!-- Approach card -->
        <div class="about-card">
            <div class="about-card-icon">🤎</div>

            <h3>
                Vores tilgang
            </h3>

            <p>
                Vi fokuserer på enkle løsninger, der passer til en travl hverdag.
                Systemet skal være nemt at bruge, hurtigt at forstå og give værdi
                uden at gøre hverdagen mere kompliceret.
            </p>
        </div>

        <!-- Values card -->
        <div class="about-card">
            <div class="about-card-icon">✨</div>

            <h3>
                Vores værdier
            </h3>

            <p>
                Tryghed, fællesskab og brugervenlighed er centrale værdier.
                Forældre skal føle sig støttet og have adgang til funktioner,
                der giver overblik og ro.
            </p>
        </div>

        <!-- BabyLog card -->
        <div class="about-card">
            <div class="about-card-icon">👶</div>

            <h3>
                BabyLog
            </h3>

            <p>
                BabyLog hjælper indtil nu forældre med at registrere barnets søvn og få
                et visuelt overblik over søvnmønstre og udvikling over tid.
                Senere vil det være muligt at registrere barnets madlog, udvikling osv.
            </p>
        </div>

        <!-- Chat community card -->
        <div class="about-card">
            <div class="about-card-icon">💬</div>

            <h3>
                Chat Community
            </h3>

            <p>
                Chat Community er tænkt som et digitalt fællesskab, hvor forældre
                kan stille spørgsmål, dele erfaringer og støtte hinanden i hverdagen.
            </p>
        </div>

    </div>

    <!-- Back navigation -->
    <div class="about-actions">

        <button class="about-main-button"
                type="button"
                @onclick="TilDashboard">
            <span class="button-icon">←</span>
            <span>Tilbage til Dashboard</span>
        </button>

    </div>

</div>

<style>
    .about-container {
        padding: 2rem;
        max-width: 1200px;
        margin: auto;
    }

    .about-hero {
        background: linear-gradient(135deg, #fffdfb, #f7e7dc);
        border-radius: 32px;
        padding: 3rem 2rem;
        text-align: center;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .about-label {
        display: inline-block;
        background-color: rgba(201, 143, 118, 0.14);
        color: #8f5f4a;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .about-hero h1 {
        color: #6f4637;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .about-hero p {
        max-width: 760px;
        margin: auto;
        color: #6d6d6d;
        line-height: 1.8;
    }

    .about-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
    }

    .about-card {
        background-color: #fffdfb;
        border-radius: 26px;
        padding: 2rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.05);
        transition: 0.2s ease;
    }

        .about-card:hover {
            transform: translateY(-3px);
        }

        .about-card h3 {
            color: #6f4637;
            margin-bottom: 0.8rem;
            font-weight: 700;
        }

        .about-card p {
            color: #6d6d6d;
            line-height: 1.7;
            margin-bottom: 0;
        }

    .about-card-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background-color: #f7e7dc;
        color: #6f4637;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 1rem;
    }

    .about-actions {
        margin-top: 2.5rem;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
    }

    .about-main-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.9rem 1.7rem;
        border-radius: 999px;
        border: none;
        background-color: #c98f76;
        color: white;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(201, 143, 118, 0.25);
        cursor: pointer;
        transition: 0.2s ease;
    }

        .about-main-button:hover {
            background-color: #b77c63;
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(201, 143, 118, 0.32);
        }

    .button-icon {
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .about-container {
            padding: 1rem;
        }

        .about-hero {
            padding: 2.5rem 1.5rem;
        }

        .about-main-button {
            width: 100%;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string ActiveToken =>
        !string.IsNullOrWhiteSpace(Token)
            ? Token
            : TokenStorage.Token ?? "";

    private string TokenQuery =>
        string.IsNullOrWhiteSpace(ActiveToken)
            ? ""
            : $"?token={Uri.EscapeDataString(ActiveToken)}";

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Token))
        {
            TokenStorage.Token = Token;
        }
    }

    private void TilDashboard()
    {
        if (!string.IsNullOrWhiteSpace(ActiveToken))
        {
            TokenStorage.Token = ActiveToken;
        }

        Navigation.NavigateTo(
            $"/dashboard{TokenQuery}",
            forceLoad: true
        );
    }
}