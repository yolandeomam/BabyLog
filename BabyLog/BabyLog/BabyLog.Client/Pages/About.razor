@page "/about"

<PageTitle>Om BabyFællesskab</PageTitle>

<div class="about-container">

    <!-- About header -->
    <div class="about-hero">

        <span class="about-label">
            BabyFællesskab
        </span>

        <h1>
            Om BabyFællesskab
        </h1>

        <p>
            BabyFællesskab er skabt med ønsket om at give forældre et trygt,
            overskueligt og støttende sted, hvor fællesskab og digitale værktøjer
            kan gøre hverdagen med små børn lettere.
        </p>

    </div>

    <!-- About cards -->
    <div class="about-grid">

        <!-- Approach card -->
        <div class="about-card">

            <h3>
                Vores tilgang
            </h3>

            <p>
                Vi fokuserer på enkle løsninger, der passer til en travl hverdag.
                Systemet skal være nemt at bruge, hurtigt at forstå og give værdi
                uden at gøre hverdagen mere kompliceret.
            </p>

        </div>

        <!-- Values card -->
        <div class="about-card">

            <h3>
                Vores værdier
            </h3>

            <p>
                Tryghed, fællesskab og brugervenlighed er centrale værdier.
                Forældre skal føle sig støttet og have adgang til funktioner,
                der giver overblik og ro.
            </p>

        </div>

        <!-- BabyLog card -->
        <div class="about-card">

            <h3>
                BabyLog
            </h3>

            <p>
                BabyLog hjælper indtil nu forældre med at registrere barnets søvn og få
                et visuelt overblik over søvnmønstre og udvikling over tid. 
                Senere vil det være muligt at kunne registrere barns madlog, udvikling osv.
            </p>

        </div>

        <!-- Chat community card -->
        <div class="about-card">

            <h3>
                Chat Community
            </h3>

            <p>
                Chat Community er tænkt som et digitalt fællesskab, hvor forældre
                kan stille spørgsmål, dele erfaringer og støtte hinanden i hverdagen.
            </p>

        </div>

    </div>

    <!-- Back navigation -->
    <div class="about-actions">

        <a class="about-button primary"
           href="/">
            Tilbage til forsiden
        </a>

    </div>

</div>

<style>
    .about-container {
        padding: 2rem;
        max-width: 1200px;
        margin: auto;
    }

    .about-hero {
        background: linear-gradient(135deg, #fffdfb, #f7e7dc);
        border-radius: 32px;
        padding: 3rem 2rem;
        text-align: center;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .about-label {
        display: inline-block;
        background-color: rgba(201, 143, 118, 0.14);
        color: #8f5f4a;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .about-hero h1 {
        color: #6f4637;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .about-hero p {
        max-width: 760px;
        margin: auto;
        color: #6d6d6d;
        line-height: 1.8;
    }

    .about-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
    }

    .about-card {
        background-color: #fffdfb;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.05);
    }

        .about-card h3 {
            color: #6f4637;
            margin-bottom: 0.8rem;
        }

        .about-card p {
            color: #6d6d6d;
            line-height: 1.7;
            margin-bottom: 0;
        }

    .about-actions {
        margin-top: 2rem;
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .about-button {
        padding: 0.85rem 1.5rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
    }

        .about-button.primary {
            background-color: #fffdfb;
            color: #6f4637;
            border: 1px solid #ead7cc;
        }

            .about-button.primary:hover {
                background-color: #f7e7dc;
                color: #6f4637;
            }
</style>