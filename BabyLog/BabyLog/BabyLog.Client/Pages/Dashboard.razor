@page "/dashboard"
@rendermode InteractiveServer
@inject BabyLog.Client.Services.TokenStorageService TokenStorage
@inject BabyLog.Client.ViewModels.ChildViewModel ChildViewModel
@inject NavigationManager Navigation

<div class="container py-4">

    <!-- Dashboard header -->
    <div class="dashboard-header card border-0 shadow-sm rounded-5 p-5 mb-4">

        <span class="small text-muted">
            BabyFællesskab
        </span>

        <h2 class="mb-1">
            BabyLog Dashboard
        </h2>

        @if (ChildViewModel.CurrentCustomer != null)
        {
            <p class="text-muted mb-0">
                Velkommen, @ChildViewModel.CurrentCustomer.FirstName.
                Her kan du administrere barnets profil og søvnlog.
            </p>
        }
        else
        {
            <p class="text-muted mb-0">
                Velkommen til BabyLog. Her kan du få overblik over barnets hverdag.
            </p>
        }

    </div>

    <!-- Error message -->
    @if (!string.IsNullOrEmpty(ChildViewModel.ErrorMessage))
    {
        <div class="alert alert-danger">
            @ChildViewModel.ErrorMessage
        </div>
    }

    <!-- Feature cards -->
    <div class="row g-3">

        <!-- Children feature -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="feature-card card border-0 shadow-sm rounded-4 h-100 p-4">

                <div class="feature-icon mb-3">
                    👶
                </div>

                <h4>
                    Børn
                </h4>

                <p class="text-muted">
                    Opret, se, opdater og slet barnets profil.
                </p>

                <button class="btn btn-primary rounded-pill mt-auto w-100"
                        @onclick="OpenChildren">
                    Åbn børn
                </button>

            </div>
        </div>

        <!-- Sleep feature -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="feature-card card border-0 shadow-sm rounded-4 h-100 p-4">

                <div class="feature-icon mb-3">
                    🌙
                </div>

                <h4>
                    Søvnlog
                </h4>

                <p class="text-muted">
                    Registrer og se barnets søvn samt få overblik over søvnmønster.
                </p>

                <button class="btn btn-primary rounded-pill mt-auto w-100"
                        @onclick="OpenChildrenForSleep">
                    Vælg barn
                </button>

            </div>
        </div>

        <!-- Milestones future feature -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="feature-card card border-0 shadow-sm rounded-4 h-100 p-4 opacity-75">

                <div class="feature-icon mb-3">
                    ⭐
                </div>

                <h4 class="milestone-title">
                    Udviklingsmilepæle
                </h4>

                <p class="text-muted">
                    Fremtidig funktion til registrering af barnets udvikling.
                </p>

                <button class="btn btn-outline-secondary rounded-pill mt-auto w-100"
                        disabled>
                    Kommer senere
                </button>

            </div>
        </div>

    </div>

    <!-- Back navigation -->
    <div class="dashboard-actions text-center mt-5">

        <a class="btn btn-light rounded-pill px-4 border me-2 mb-2"
           href="/">
           Tilbage til forsiden
        </a>

        <a class="btn btn-outline-secondary rounded-pill px-4 mb-2"
           href="https://localhost:7049/">
           Tilbage til BabyFællesskab
        </a>

    </div>

</div>

<style>
    .card {
        background-color: #fffdfb;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #fffdfb, #f7e7dc);
        border-radius: 32px !important;
        padding: 3rem !important;
    }

    .feature-card {
        display: flex;
        flex-direction: column;
        transition: 0.2s ease;
    }

        .feature-card:hover {
            transform: translateY(-4px);
        }

    .feature-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background-color: #f7e7dc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
    }

    .milestone-title {
        white-space: nowrap;
        font-size: 1.3rem;
    }

    .btn-primary {
        background-color: #c98f76;
        border-color: #c98f76;
    }

        .btn-primary:hover {
            background-color: #b77c63;
            border-color: #b77c63;
        }

    .btn-outline-secondary {
        border-color: #d8c1b5;
        color: #6f4637;
    }

        .btn-outline-secondary:hover {
            background-color: #f7e7dc;
            border-color: #f7e7dc;
            color: #6f4637;
        }

    .btn-light {
        color: #6f4637;
        background-color: #fffdfb;
    }

        .btn-light:hover {
            background-color: #f7e7dc;
            color: #6f4637;
        }

    .dashboard-actions {
        color: #6f4637;
    }
</style>

@code {

    // JWT token from query string
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    // Reuse token during navigation
    private string TokenQuery =>
        string.IsNullOrWhiteSpace(Token)
            ? ""
            : $"?token={Uri.EscapeDataString(Token)}";

    protected override async Task OnInitializedAsync()
    {
        // Save newest token
        if (!string.IsNullOrWhiteSpace(Token))
        {
            TokenStorage.Token = Token;

            // Clear old ViewModel data
            ChildViewModel.Children.Clear();
            ChildViewModel.SelectedChild = null;
            ChildViewModel.CurrentCustomer = null;
            ChildViewModel.ErrorMessage = null;
        }

        // Load current customer
        await ChildViewModel.LoadCurrentCustomerAsync();
    }

    // Navigate to children overview
    private void OpenChildren()
    {
        Navigation.NavigateTo(
            $"/children{TokenQuery}"
        );
    }

    // Navigate to children overview, where customer can choose child for sleep
    private void OpenChildrenForSleep()
    {
        Navigation.NavigateTo(
            $"/children{TokenQuery}"
        );
    }
}